using UnityEngine;

public class Array : MonoBehaviour
{
    // Array'lerde maksimum eleman sayisi bellidir. Belirlenmelidir.
    private string[] customers = new string[5];
    private string targetCustomer;
    void Start()
    {
        // Burada dizinin [] parantez icinde belirtilen indeksine esittirden sonra gelen eleman atanir.
        customers[0] = "Ersoy";
        customers[1] = "Ali";
        customers[2] = "Michael";
        customers[3] = "Daniel";
        customers[4] = "Jessica";
        
        // Eger ki bir Array icerisinde gezinmek ve bir mantik operatoru kullanmak istiyorsak, foreach kullanabiliriz.
        // Dongu bitene kadar foreach calisir sonra dongu kirilir ve alt satira gecer.
        foreach (var c in customers)
        {
            if (c == "Ersoy")
            {
                Debug.Log(c);
            }
        }
        
        // Ayni sekilde for dongusu de kullanilabilir. For dongulerinde i nin kosulu tamamlanana kadar, yani asagidaki ornekte
        // i < 10 olana kadar for dongusu calisir. Bittiginde donguden cikar ve alt satira gecer.
        // Bunu Array e uygularsak kosulu degistiriyorum ve customers.Length i olarak setliyorum.
        for (int i = 0; i < customers.Length; i++)
        {
            Debug.Log(customers[i]);
        }
        
        Debug.Log("Dongu Bitti!");
        
    }
    
    /*
     * Array ler tipki Java da oldugu gibi C# da da kullanilir.
     * Array'ler yukarida gosterildigi gibi access turu, data turu, [] koseli parantez ve degisken adi ile tanimlanir.
     * Esitligin diger tarafinda new string gibi bir ifade ile yeni obje olusturulur ve [5] gibi bir ifadeyle Array uzunlugu belirtilir.
     * Array'lerde degisken tanimindaki [] icindeki sayi Array uzunlugunu(boyutunu), eleman atarken girilen [] icindeki sayi ise Array index numarasini belirtir.
     */
     
    /*
     * Her iki dongude de eger break; kullanirsak, kosul saglanir saglanmaz dongu kirilir ve diger else olasiliklarina gecmez.
     * Dongu kirilinca donguden cikar alt satirda calistirilacak kod varsa calisir yoksa calismayi bitirir.
     */
}
