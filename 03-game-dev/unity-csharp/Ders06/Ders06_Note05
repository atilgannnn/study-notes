using System;
using System.Collections.Generic;
using UnityEngine;

public class Array : MonoBehaviour
{
    // Global Degiskenler = Icinde bulundugu sinifin butun fonksiyonlari tarafindan ortak bir sekilde kullanilabilir.
    [SerializeField] private GameObject[] roads;
    private int _index = 0; // Bu Global Degisken olmak zorunda cunku Update icinde local degisken olursa her frame 0 a setlenecek ve artmayacak!

    private void Update()
    {
        Vector3 targetPosition = roads[_index].transform.position;
        transform.position = Vector3.MoveTowards(transform.position, targetPosition, Time.deltaTime * 10f);

        Quaternion lookRot = Quaternion.LookRotation(targetPosition - transform.position);
        
        transform.rotation = Quaternion.RotateTowards(transform.rotation, lookRot, Time.deltaTime * 250);
        
        float distance = Vector3.Distance(transform.position, targetPosition);

        if (distance < 0.1f)
        {
            if (_index < roads.Length - 1)
            {
                _index++;
            }
        }
    }

    private void Start()
    {
        // Local Degisken = Tanimlandigi fonksiyonun icerisinde kullanilabilir.
        float localFloat = -1;
        
        localFloat = transform.localPosition.x;
    }
    
    /*
     * Yukaridaki ornekte dizileri kullanarak bir kapsulu yerdeki sphere lari takip edip tek tek ziyaret edecek bir position ve rotation kodu yazdik.
     * Advance level da bu gelistirmeyi 'Spline' denilen bir yapiyla yapiyorlar. (GTA da mesela oyle)
     */
}
