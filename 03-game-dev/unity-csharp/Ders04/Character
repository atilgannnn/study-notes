    // Bu etiket degisken private iken Unity editor de set edilebilir hale getirir.
    // Prvate degiskenler '_'ifadesiyle baslar. Ancak bu etiketi alanlarda gerek yoktur.
    [SerializeField] 
    private float moveSpeed;
    
    private Rigidbody rigidBody;

    [SerializeField] 
    private GameObject door;

    private void Start()
    {
        rigidBody = GetComponent<Rigidbody>();
    }

    private void Update()
    {
        
        rigidBody.linearVelocity = new Vector3(0, 0, 1);

    }

    private void OnTriggerEnter(Collider other)
    {
        if (other.tag == "Door")
        {
            other.GetComponent<Door>().OpenDoor();
        }
    }

    private void OnTriggerStay(Collider other)
    {
    }

    private void OnTriggerExit(Collider other)
    {
        if (other.tag == "Door")
        {
            other.GetComponent<Door>().CloseDoor();
        }
    }


